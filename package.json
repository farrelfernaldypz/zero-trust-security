{
  "name": "zero-trust-sistem-nilai",
  "version": "1.0.0",
  "private": true,
  "description": "Sistem Nilai Zero Trust dengan API Gateway dan dua resource service",
  "main": "backend/src/gateway/server.js",
  "scripts": {
    "init-db": "node backend/src/shared/seed.js",
    "gateway": "node backend/src/gateway/server.js",
    "nilai": "node backend/src/services/nilai.js",
    "transkrip": "node backend/src/services/transkrip.js",
    "dev": "concurrently -k -n GATEWAY,NILAI,TRANSKRIP -c blue,green,magenta \"npm:gateway\" \"npm:nilai\" \"npm:transkrip\"",
    "test": "node --test backend/tests/integration.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
